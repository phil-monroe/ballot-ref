---
import Base from '../layouts/Base.astro';
import Bullets from '../components/Bullets.astro';
import Links from '../components/Links.astro';
import { VERIFICATION, guide } from '../lib';
const { meta } = guide;
const compiled = new Date(`${meta.guide_compiled}T12:00:00`).toLocaleDateString('en-US', { dateStyle: 'long' });
---
<Base title="About this guide">
  <h1>About this guide</h1>
  <p class="small">Compiled {compiled}. {meta.jurisdiction}, precinct {meta.precinct}.</p>
  <p class="notice">
    “Supporters say” and “critics say” lists are claims made by backers and critics, not recommendations.
    Items marked <span class="badge badge--warn">Unverified</span> or
    <span class="badge badge--warn">Campaign claim</span> have not been independently confirmed.
  </p>
  <h2>The short version</h2>
  <ul>{meta.tldr.map((t: string) => <li>{t}</li>)}</ul>
  <Bullets title="Not on this ballot" items={meta.not_on_this_ballot} />
  <Bullets title="Notes" items={meta.notes} />
  <h2 id="caveats">Caveats</h2>
  <ul class="caveats">
    {meta.caveats.map((c: any) => (
      <li id={c.id}>
        {c.verification && <span class="badge badge--warn">{VERIFICATION[c.verification] ?? c.verification}</span>}
        {c.text}
      </li>
    ))}
  </ul>
  <h2 id="claude">Use this guide with Claude or another AI chat</h2>
  <p>
    The whole guide is available as one plain-text file you can paste or upload into a chat, so you can ask questions like
    “compare the Supreme Court candidates” or “what would the transit tax cost me?”
  </p>
  <p>
    <button type="button" class="btn" data-copy-guide>Copy guide as text</button>
    <span class="small" data-copy-status role="status"></span>
  </p>
  <ul>
    <li><a href="/llms-full.txt" target="_blank" rel="noopener noreferrer">Full guide (markdown text)</a>: paste or upload this</li>
    <li><a href="/llms.txt" target="_blank" rel="noopener noreferrer">llms.txt</a>: short index for AI tools that read it</li>
    <li><a href="/guide.yaml" target="_blank" rel="noopener noreferrer">guide.yaml</a>: the raw research data</li>
  </ul>
  <p class="small">Suggested first message: “Using only the voter guide below, answer my questions, cite which source supports each claim, flag anything marked unverified or a campaign claim, and stay neutral. Don’t tell me who to vote for.”</p>
  <Links sources={meta.global_sources} label="General sources" />
</Base>
