---
import Base from '../layouts/Base.astro';
import Picker from '../components/Picker.astro';
import { contests, guide, label } from '../lib';
const { meta } = guide;
---
<Base title="My Ballot" description={`${meta.jurisdiction}, precinct ${meta.precinct}`}>
  <h1>{meta.title}</h1>
  <p class="small">
    {meta.jurisdiction} · Precinct {meta.precinct} ·
    <a href={meta.ballot_source.url} rel="noopener noreferrer">Official sample ballot</a>
  </p>
  <p class="small">
    Tap a name to mark your choice (tap again to clear). Choices and notes stay on this device only.
    <strong data-progress></strong> · <button type="button" class="link" data-reset>Reset</button>
  </p>

  {contests.map((c, i) => (
    <>
      {c.section !== contests[i - 1]?.section && <h2>{c.section}</h2>}
      <section class="row" data-row={c.id}>
        <h3>
          <a href={`/race/${c.id}/`}><span class="order">{c.ballot_order}.</span> {label(c)}</a>
          {c.contested === false && <span class="badge">Uncontested</span>}
        </h3>
        {c.term && <p class="small">{c.term}</p>}
        <Picker c={c} />
        <p class="note-view" data-note-view hidden></p>
        <a class="more" href={`/race/${c.id}/`}>Details &rarr;</a>
      </section>
    </>
  ))}
</Base>
