---
import Base from '../../layouts/Base.astro';
import Contest from '../../components/Contest.astro';
import Picker from '../../components/Picker.astro';
import AskClaude from '../../components/AskClaude.astro';
import { contests, label } from '../../lib';

export function getStaticPaths() {
  return contests.map((c, i) => ({
    params: { id: c.id },
    props: { c, prev: contests[i - 1], next: contests[i + 1] },
  }));
}
const { c, prev, next } = Astro.props;
---
<Base title={label(c)}>
  <h1>{label(c)}</h1>
  <section class="part" data-row={c.id} aria-labelledby="your-choice">
    <h2 class="part-title" id="your-choice">Your choice</h2>
    <Picker c={c} />
    <label class="note-label">
      Notes
      <textarea data-note={c.id} rows="2" placeholder="Private notes, saved on this device"></textarea>
    </label>
  </section>
  <Contest c={c} />
  <section class="part" aria-labelledby="ask-claude">
    <h2 class="part-title" id="ask-claude">Ask Claude</h2>
    <p class="small">Have questions about this race? Copy these details into a Claude chat to compare the options and ask follow-ups.</p>
  <AskClaude src={`/race/${c.id}.txt`} prompt={`I pasted a voter guide section for "${label(c)}" below (I will paste it right after this message). Help me understand it: compare the options, cite which source supports each claim, flag anything marked unverified or a campaign claim, and stay neutral. Do not tell me who to vote for. My first question: `} />
  </section>
  <nav class="bottom-nav" aria-label="Contest navigation">
    {prev ? <a href={`/race/${prev.id}/`} aria-label="Previous contest">&lsaquo; Prev</a> : <span />}
    <a href="/" class="bottom-all">All contests</a>
    {next ? <a href={`/race/${next.id}/`} aria-label="Next contest">Next &rsaquo;</a> : <span />}
  </nav>
</Base>
