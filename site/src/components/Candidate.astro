---
import Bullets from './Bullets.astro';
import Links from './Links.astro';
import { VERIFICATION } from '../lib';
const { c } = Astro.props;
const hasMore = ['positions', 'money', 'endorsements', 'support', 'oppose'].some((k) => c[k]?.length);
---
<article class="card">
  <h4>
    {c.name}
    {c.party && <span class="party">{c.party}</span>}
    {c.incumbent && <span class="badge">Incumbent</span>}
    {c.verification && <span class="badge badge--warn">{VERIFICATION[c.verification] ?? c.verification}</span>}
  </h4>
  <p class="site">
    {c.website
      ? <a href={c.website} rel="noopener noreferrer">Campaign website &nearr;</a>
      : <span class="badge badge--none">No website found</span>}
  </p>
  {c.summary && <p>{c.summary}</p>}
  {c.verification_note && <p class="small">{c.verification_note}</p>}
  {c.website && (
    <>
      <Bullets title="Top priorities (per campaign site)" items={c.priorities} />
      {c.priority_details?.length > 0 && (
        <details class="sources">
          <summary>Full list from the campaign site ({c.priority_details.length})</summary>
          <dl class="prio">
            {c.priority_details.map((d: { title: string; summary: string }) => (
              <>
                <dt>{d.title}</dt>
                <dd>{d.summary}</dd>
              </>
            ))}
          </dl>
        </details>
      )}
      {c.priorities_note && <p class="small">{c.priorities_note}</p>}
    </>
  )}
  {hasMore && (
    <details class="more-info">
      <summary>Positions, money, endorsements &amp; arguments</summary>
      <Bullets title="Stated positions" items={c.positions} />
      <Bullets title="Money" items={c.money} />
      <Bullets title="Endorsements" items={c.endorsements} />
      <div class="pair">
        <Bullets title="Supporters say" items={c.support} class="for" />
        <Bullets title="Critics say" items={c.oppose} class="against" />
      </div>
    </details>
  )}
  <Links sources={c.sources} />
</article>
