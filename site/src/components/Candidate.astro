---
import Bullets from './Bullets.astro';
import Links from './Links.astro';
import PfItems from './PfItems.astro';
import { VERIFICATION, list, politifactLinks } from '../lib';
const { c, contestId } = Astro.props;
const pf = politifactLinks(c);
const has = (...keys: string[]) => keys.some((k) => list(c[k]).length > 0);
---
<article class="card">
  <div class="card-head">
  <button type="button" class="card-check" data-contest={contestId} data-choice={c.name} aria-pressed="false" aria-label={`Choose ${c.name}`}>
    <span class="box" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
    </span>
  </button>
  <h4>
    {c.name}
    {c.party && <span class="party">{c.party}</span>}
    {c.incumbent && <span class="badge">Incumbent</span>}
    {c.verification && <span class="badge badge--warn">{VERIFICATION[c.verification] ?? c.verification}</span>}
  </h4>
  </div>
  <p class="site">
    {c.website
      ? <a href={c.website} target="_blank" rel="noopener noreferrer">Campaign website &nearr;</a>
      : <span class="badge badge--none">No website found</span>}
  </p>

  <div class="sec" data-sec="summary">
    <h5 class="sec-title">Summary</h5>
    {c.summary ? <p>{c.summary}</p> : <p class="empty">No summary listed.</p>}
    {c.verification_note && <p class="small">{c.verification_note}</p>}
    <Links sources={c.sources} />
  </div>

  <div class="sec" data-sec="resume">
    <h5 class="sec-title">Resume</h5>
    {has('resume') ? <ul>{list(c.resume).map((p) => <li>{p}</li>)}</ul> : <p class="empty">No background found.</p>}
    <Links sources={c.resume_sources} label="Resume sources" />
  </div>

  <div class="sec" data-sec="track">
    <h5 class="sec-title">Track record</h5>
    {has('track_record') ? <ul>{list(c.track_record).map((p) => <li>{p}</li>)}</ul> : <p class="empty">Has not held elected office.</p>}
    {has('track_record') && <p class="small">Highlights drawn from the campaign's own materials and public biographies, not an evaluation. Criticism is under Endorsements + arguments.</p>}
  </div>

  <div class="sec" data-sec="priorities">
    <h5 class="sec-title">Stated priorities (per campaign site)</h5>
    {has('priorities') ? (
      <ul>{list(c.priorities).map((p) => <li>{p}</li>)}</ul>
    ) : (
      <p class="empty">{c.website ? 'The campaign site lists no priorities.' : 'No campaign website, so no priorities to summarize.'}</p>
    )}
    {c.priority_details?.length > 0 && (
      <details class="sources">
        <summary>{has('priorities') ? 'Full list' : 'Background'} from the campaign site ({c.priority_details.length})</summary>
        <dl class="prio">
          {c.priority_details.map((d: { title: string; summary: string }) => (
            <>
              <dt>{d.title}</dt>
              <dd>{d.summary}</dd>
            </>
          ))}
        </dl>
      </details>
    )}
    {c.priorities_note && <p class="small">{c.priorities_note}</p>}
  </div>

  <div class="sec" data-sec="positions">
    <h5 class="sec-title">Positions</h5>
    {has('positions') ? <ul>{list(c.positions).map((p) => <li>{p}</li>)}</ul> : <p class="empty">None listed.</p>}
  </div>

  <div class="sec" data-sec="money">
    <h5 class="sec-title">Money</h5>
    {has('money') ? <ul>{list(c.money).map((p) => <li>{p}</li>)}</ul> : <p class="empty">None listed.</p>}
  </div>

  <div class="sec" data-sec="factchecks">
    <h5 class="sec-title">PolitiFact</h5>
    <ul class="pf">
      {pf.map((l) => <li><a href={l.url} target="_blank" rel="noopener noreferrer">{l.label} &nearr;</a></li>)}
    </ul>
    <PfItems items={c.politifact_items} />
    <p class="small">{pf.some((l) => l.direct) ? 'PolitiFact rates statements by the person named; the items above are about this race or candidate. Older fact-checks are on the profile page.' : 'No PolitiFact profile page was found. The search link lists any fact-checks or articles that mention them.'}</p>
  </div>

  <div class="sec" data-sec="arguments">
    <h5 class="sec-title">Endorsements &amp; arguments</h5>
    {!has('endorsements', 'support', 'oppose') && <p class="empty">None listed.</p>}
    <Bullets title="Endorsements" items={c.endorsements} />
    <Bullets title="Supporters say" items={c.support} class="for" />
    <Bullets title="Critics say" items={c.oppose} class="against" />
  </div>
</article>
